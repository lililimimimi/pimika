{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pimika",
  "version": "0.1.0",
  "identifier": "dev.pimika.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../backend/packaging/dist/pi-backend": "backend/pi-backend",
      "../../pi-bridge/packaging/dist/bridge": "bridge"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
